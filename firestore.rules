rules_version = '2';
// Onco360 – règles de sécurité : plateforme multi-cabinets (espaces/…), droits par membre choisis par le titulaire.
// (L'ancienne application v1 et ses règles ont été retirées le 11/10/2026.)
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() { return request.auth != null; }
    function proprietaire() { return connecte() && request.auth.token.email == 'ritabentahila@gmail.com'; }

    // Ancienne application (v1) : retirée le 11/10/2026 (site, puis règles) ; ses collections racine (patients, protocoles,
    // parametres, finances, roles, historique) ne sont plus ouvertes à personne (aucune règle = refus).

    // ───────────── PARTIE 2 : v2 ─────────────
    // Administrateurs de la plateforme (compte d'administration séparé depuis le 09/10/2026) : chacun lit sa fiche ; liste tenue
    // par Dr Bentahila (console). Le compte d'administration ne lit ni les profils ni les cabinets : tout passe par les fonctions.
    match /administrateurs/{uid} { allow read: if connecte() && (request.auth.uid == uid || proprietaire()); allow write: if proprietaire(); }

    // Heure du Maroc (S1, 21/10/2026) : changements d'heure ajoutés par l'Administration, lus au démarrage par tout compte connecté ;
    // écrits par la fonction heureMaroc seulement
    match /plateforme/heureMaroc { allow read: if connecte(); allow write: if false; }

    // Profil personnel : chacun lit et modifie le sien (aucun droit n'y est stocké) ; Dr Bentahila aussi ceux de son équipe (inchangé)
    match /utilisateurs/{uid} {
      allow read: if connecte() && (request.auth.uid == uid || proprietaire());
      allow create, update: if connecte() && (request.auth.uid == uid || proprietaire());
      allow delete: if proprietaire();
    }

    // Journal d'audit (étape 9, 09/10/2026) : écrit par le serveur seulement (auditEcriture), jamais modifié ni effacé depuis le
    // navigateur ; lu par le médecin titulaire du cabinet (cabinet non suspendu)
    match /audit/{e}/lignes/{l} {
      allow read: if connecte() && get(/databases/$(database)/documents/espaces/$(e)).data.titulaire == request.auth.uid
        && get(/databases/$(database)/documents/espaces/$(e)).data.get('actif', true) != false;
      allow write: if false;
    }
    // Cabinet ouvert par chaque compte (phase F, 09/10/2026) : lu par la personne, écrit par le serveur seulement (compteMembre, creerCabinet)
    match /comptes/{uid} { allow read: if connecte() && request.auth.uid == uid; allow write: if false; }

    match /espaces/{e} {
      // Plusieurs cabinets (09/10/2026) : le compte de Dr Bentahila ne garde ses pouvoirs d'administratrice que dans son propre
      // cabinet ; le compte d'administration (collection administrateurs) n'ouvre aucun cabinet (création par fonction serveur).
      function adminIci() { return proprietaire() && e == 'cabinet-bentahila'; }
      function cheminMembre() { return /databases/$(database)/documents/espaces/$(e)/membres/$(request.auth.uid); }
      function m() { return get(cheminMembre()).data; }
      // Cabinet suspendu par l'administration (abonnement non payé, 09/10/2026) : plus personne n'y entre ; rien n'est effacé
      function cabinetActif() { return get(/databases/$(database)/documents/espaces/$(e)).data.get('actif', true) != false; }
      // Lot C (25/10/2026) : un médecin remplaçant n'entre que pendant sa période (remplaceDebMs / remplaceFinMs, absents ou 0 = sans limite)
      function periodeOk() { return m().role != 'remplacant' || ((m().get('remplaceDebMs', 0) == 0 || request.time >= timestamp.value(m().remplaceDebMs)) && (m().get('remplaceFinMs', 0) == 0 || request.time <= timestamp.value(m().remplaceFinMs))); }
      function estMembre() { return connecte() && exists(cheminMembre()) && m().actif == true && cabinetActif() && periodeOk(); }
      // Lot C : le remplaçant agit comme un médecin (mêmes droits que le titulaire, recopiés par le serveur)
      function estMed() { return m().role in ['medecin', 'remplacant']; }
      // Module de la formule (1.3, 11/10/2026) : un module retiré (abonnement.modules[k] == false) est aussi fermé à l'écriture par le
      // serveur, pas seulement caché à l'écran ; cabinet sans abonnement (cabinet Bentahila) = tous les modules
      function moduleOn(k) { return get(/databases/$(database)/documents/espaces/$(e)).data.get('abonnement', {}).get('modules', {}).get(k, true) != false; }
      function estTitulaire() { return connecte() && get(/databases/$(database)/documents/espaces/$(e)).data.titulaire == request.auth.uid; }
      function droit(k) { return estMembre() && m().droits[k] == true; }
      function traitementsModif() { return estMembre() && m().droits.traitements == 'modifier'; }
      function rtModif() { return estMembre() && m().droits.radiotherapie == 'modifier'; }
      function tousEtab() { return estMembre() && m().tousEtablissements == true; }
      // Comptable (étape 9 S2, 09/10/2026) : volet financier seulement ; aucun dossier ni donnée médicale (le périmètre lui est fermé)
      function comptable() { return estMembre() && m().role == 'comptable'; }
      function dansPerimetre(etab) { return estMembre() && m().role != 'comptable' && (m().tousEtablissements == true || etab in m().etablissements); }
      // Champs d'un dossier patient que ce membre a le droit de modifier
      // 12/10/2026 : fiche du membre lue une seule fois (limite du nombre d'expressions évaluées par écriture) ; droit absent = non
      function champsAutorises() { return estMembre() ? champsDe(m().droits, m().tousEtablissements == true) : ['resume', 'version', 'maj', 'majPar']; }
      function champsDe(d, tous) {
        return ['resume', 'version', 'maj', 'majPar']
          .concat(d.get('identite', false) == true ? ['identite'] : [])
          .concat(d.get('fichePatient', false) == true ? ['clinique'] : [])
          .concat(d.get('rendezvous', false) == true ? ['rdvsJson', 'rappels'] : []) // rappels : rappels WhatsApp envoyés (19.4)
          // heures des séances de chimio et de leur consultation (12/10/2026, champ « heures ») : médecin, secrétaire (planning), infirmière
          .concat(d.get('planningChimio', false) == true || d.get('traitements', '') == 'modifier' ? ['planningJson', 'heures'] : d.get('administrer', false) == true ? ['heures'] : [])
          .concat(d.get('traitements', '') == 'modifier' ? ['lignesJson', 'clinique'] : [])
          .concat(d.get('radiotherapie', '') == 'modifier' ? ['rtsJson'] : [])
          .concat(tous ? ['etablissementId', 'hopHist'] : []); // hopHist : hôpital des actes faits avant un changement (15 bis)
      }
      // Fiche du patient (droit « fichePatient », secrétaire) : poids, taille, allergies… mais pas le résumé médical (clinique.notes)
      function notesInchangees() {
        return traitementsModif() || request.resource.data.get('clinique', {}).get('notes', '') == resource.data.get('clinique', {}).get('notes', '');
      }
      function notesVides() { return traitementsModif() || request.resource.data.get('clinique', {}).get('notes', '') == ''; }
      // Toute écriture d'un dossier : version suivante, auteur et heure fixés par le serveur
      function versionSuivante() {
        return request.resource.data.version == resource.data.version + 1
          && request.resource.data.majPar == request.auth.uid
          && request.resource.data.maj == request.time;
      }

      // Fiche du cabinet : aussi lisible par ses membres quand il est suspendu (message « accès suspendu »)
      allow read: if estMembre() || adminIci() || (connecte() && exists(cheminMembre()));
      allow write: if adminIci();

      // Membres et leurs droits : gérés par le médecin titulaire (ou l'administrateur). Un membre ne modifie jamais ses propres droits.
      match /membres/{uid} {
        allow read: if estMembre() || adminIci();
        // Lot C (25/10/2026) : chacun lit sa propre fiche, même désactivée ou hors de sa période de remplacement (message clair à l'ouverture)
        allow get: if connecte() && uid == request.auth.uid;
        // 1.3 (11/10/2026, audit) : un nouveau membre n'est créé que par le serveur (creerMembre : limite de la formule, compte
        // vérifié) ; le titulaire modifie ou retire les fiches existantes, jamais la sienne. Il ne peut plus rattacher lui-même un
        // compte quelconque à son cabinet.
        allow create: if adminIci();
        allow update, delete: if adminIci() || (estTitulaire() && uid != request.auth.uid);
      }
      // Établissements (nom, adresse, logo) : visibles par les membres, modifiables avec le droit « paramètres »
      match /etablissements/{x} {
        allow read: if estMembre() || adminIci();
        allow write: if droit('parametres') || adminIci();
        // secrétaire (droit « secretariat », 19.3) : adresse, téléphone et ville de ses lieux seulement (ni code, ni nom, ni logo)
        allow update: if droit('secretariat') && (tousEtab() || x in m().etablissements)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adresse', 'tel', 'ville']);
      }
      // Dossiers patients (sans aucun montant)
      match /patients/{p} {
        allow read: if dansPerimetre(resource.data.etablissementId);
        allow create: if droit('creerPatient') && dansPerimetre(request.resource.data.etablissementId)
          && request.resource.data.version == 1 && request.resource.data.majPar == request.auth.uid && request.resource.data.maj == request.time
          && request.resource.data.keys().hasOnly(champsAutorises().concat(['etablissementId'])) && notesVides();
        allow update: if dansPerimetre(resource.data.etablissementId) && versionSuivante()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(champsAutorises()) && notesInchangees();
        allow delete: if droit('supprimerPatient') && dansPerimetre(resource.data.etablissementId);
      }
      // Journal des consultations (une fiche par consultation, avec le patient et son établissement) : lu par tous les membres
      // (périmètre), écrit avec le droit « ecrireConsultations » (médecin, secrétaire), supprimé par le médecin (toutes) ou
      // par celui qui l'a créée (07/10/2026)
      match /consultations/{c} {
        allow read: if dansPerimetre(resource.data.etablissementId);
        allow create: if droit('ecrireConsultations') && dansPerimetre(request.resource.data.etablissementId)
          && request.resource.data.creePar == request.auth.uid && request.resource.data.majPar == request.auth.uid;
        allow update: if droit('ecrireConsultations') && dansPerimetre(resource.data.etablissementId)
          && dansPerimetre(request.resource.data.etablissementId) && request.resource.data.majPar == request.auth.uid
          && request.resource.data.creePar == resource.data.creePar && request.resource.data.patientId == resource.data.patientId;
        // suppression : le médecin ; la secrétaire celles qu'elle a créées, et une consultation « Ordonnance » vidée
        allow delete: if droit('ecrireConsultations') && dansPerimetre(resource.data.etablissementId)
          && (estMed() || resource.data.creePar == request.auth.uid || (resource.data.titre == 'Ordonnance' && resource.data.get('type', '') == ''
              && resource.data.get('note', '') == '' && resource.data.get('lignes', []).size() == 0));
      }
      // Inscriptions en RCP (09/10/2026, rcp.js) : lues par tous les membres (périmètre) ; inscrire, modifier, cocher « Fait » :
      // droit « ecrireConsultations » (médecin, secrétaire) ; l'auteur et le patient ne changent pas ; désinscrire : le médecin,
      // ou qui a inscrit
      match /rcp/{r} {
        allow read: if dansPerimetre(resource.data.etablissementId);
        allow create: if droit('ecrireConsultations') && moduleOn('rcp') && dansPerimetre(request.resource.data.etablissementId)
          && request.resource.data.creePar == request.auth.uid && request.resource.data.majPar == request.auth.uid
          && request.resource.data.d is string && request.resource.data.patientId is string;
        allow update: if droit('ecrireConsultations') && dansPerimetre(resource.data.etablissementId)
          && dansPerimetre(request.resource.data.etablissementId) && request.resource.data.majPar == request.auth.uid
          && request.resource.data.creePar == resource.data.creePar && request.resource.data.patientId == resource.data.patientId;
        allow delete: if droit('ecrireConsultations') && dansPerimetre(resource.data.etablissementId)
          && (estMed() || resource.data.creePar == request.auth.uid);
      }
      // Bibliothèques des prescriptions (médicaments, examens, ordonnances types, analyses, courriers) : lues par les
      // membres, modifiées par le médecin seulement (07/10/2026 : la secrétaire s'en sert sans les changer)
      // R-E5 (19/10/2026, audit n° 7, d. 17 et question 1) : la secrétaire voit et prescrit, ne modifie rien, ajout de médicament compris
      // (du 10/10 au 19/10, elle pouvait ajouter un médicament) ; elle garde la ligne libre sur l'ordonnance
      match /bibliotheques/{b} {
        allow read: if estMembre();
        allow write: if droit('ecrireConsultations') && estMed();
      }
      // Documents de radiothérapie (pli confidentiel, compte rendu de fin, rendez-vous) enregistrés depuis leur fenêtre :
      // lus, modifiés et supprimés avec le droit « documents » (médecin, secrétaire), dans le périmètre du membre
      match /documentsRT/{d} {
        allow read, delete: if droit('documents') && dansPerimetre(resource.data.etablissementId);
        allow create: if droit('documents') && moduleOn('documents') && dansPerimetre(request.resource.data.etablissementId) && request.resource.data.majPar == request.auth.uid;
        allow update: if droit('documents') && dansPerimetre(resource.data.etablissementId) && dansPerimetre(request.resource.data.etablissementId)
          && request.resource.data.majPar == request.auth.uid;
      }
      // Documents déposés dans le dossier (onglet Documents, 08/10/2026) : fiche du fichier (titre, date, type, chemin dans le
      // stockage, voir storage.rules) ; droit « documents » dans le périmètre ; supprimés par le médecin ou par qui les a déposés
      match /fichiers/{f} {
        allow read: if droit('documents') && dansPerimetre(resource.data.etablissementId);
        allow create: if droit('documents') && moduleOn('documents') && dansPerimetre(request.resource.data.etablissementId)
          && request.resource.data.creePar == request.auth.uid && request.resource.data.majPar == request.auth.uid;
        allow update: if droit('documents') && dansPerimetre(resource.data.etablissementId) && dansPerimetre(request.resource.data.etablissementId)
          && request.resource.data.majPar == request.auth.uid && request.resource.data.creePar == resource.data.creePar
          && request.resource.data.patientId == resource.data.patientId && request.resource.data.chemin == resource.data.chemin;
        allow delete: if droit('documents') && dansPerimetre(resource.data.etablissementId)
          && (estMed() || resource.data.creePar == request.auth.uid);
      }
      // Tâches de l'équipe (07/10/2026) : les médecins les voient toutes ; les autres celles qu'ils ont créées ou dont ils sont
      // responsables (qui = [auteur, responsable]). Modification et réattribution : l'auteur, le responsable, les médecins ;
      // l'auteur ne change jamais ; chaque modification ou commentaire ajoute une entrée au fil (historique), qui ne rétrécit
      // jamais, signée par la personne connectée (08/10/2026).
      // Suppression : l'auteur, toujours (même terminée, 08/10/2026) ; un médecin, une tâche non terminée d'un autre.
      match /taches/{t} {
        function estMedecin() { return estMembre() && estMed(); }
        function concerne() { return estMedecin() || (estMembre() && request.auth.uid in resource.data.qui); }
        function valide(d) {
          return d.titre is string && d.titre.size() > 0 && d.statut in ['afaire', 'encours', 'fait'] && d.majPar == request.auth.uid
            && d.qui is list && d.qui.hasAll([d.de, d.pour]) && d.qui.hasOnly([d.de, d.pour])
            && exists(/databases/$(database)/documents/espaces/$(e)/membres/$(d.pour));
        }
        allow read: if concerne();
        allow create: if estMembre() && moduleOn('taches') && request.resource.data.de == request.auth.uid && valide(request.resource.data)
          && request.resource.data.statut == 'afaire' && request.resource.data.fil.size() == 1 && request.resource.data.fil[0].par == request.auth.uid;
        allow update: if concerne() && valide(request.resource.data) && request.resource.data.de == resource.data.de
          && request.resource.data.fil.size() == resource.data.fil.size() + 1
          && request.resource.data.fil[0:resource.data.fil.size()] == resource.data.fil // 1.3 : l'historique déjà écrit ne change jamais
          && request.resource.data.fil[request.resource.data.fil.size() - 1].par == request.auth.uid;
        allow delete: if (estMembre() && resource.data.de == request.auth.uid) || (estMedecin() && resource.data.statut != 'fait');
      }
      // Salle d'attente (08/10/2026) : un document par patient, ligne du jour (rendez-vous ou séance de chimio) et jour, lu et
      // écrit dans le périmètre du membre. Tout membre « Met en salle » (état "" ou salle, infirmière comprise) ; démarrer la
      // consultation, valider, absent, retour en salle : droit « rendezvous » (médecin, secrétaire). Patient et jour ne changent pas.
      match /salle/{s} {
        function etapeLibre(d) { return d.etat in ['', 'salle'] || droit('rendezvous'); }
        function valideSalle(d) {
          return d.patientId is string && d.jour is string && d.cle is string && d.etat in ['', 'salle', 'consult', 'vu', 'absent']
            && d.majPar == request.auth.uid && s == d.jour + '_' + d.patientId + '_' + d.cle;
        }
        // lecture d'une ligne pas encore créée : permise aux membres (les actions relisent la ligne en transaction, SA4 10/10/2026)
        allow read: if resource == null ? estMembre() : dansPerimetre(resource.data.etablissementId);
        // prix payé d'avance (prix) : seulement avec le droit « encaissements » ou « finances » (08/10/2026)
        function prixPermis() { return droit('encaissements') || droit('finances'); }
        allow create: if moduleOn('salle') && dansPerimetre(request.resource.data.etablissementId) && valideSalle(request.resource.data) && etapeLibre(request.resource.data)
          && (!request.resource.data.keys().hasAny(['prix']) || prixPermis());
        // commentaire du jour (com) : tout membre du périmètre, quelle que soit l'étape (infirmière comprise, 08/10/2026)
        function commentaireSeul() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['com', 'comPar', 'comNom', 'maj', 'majPar']); }
        allow update: if dansPerimetre(resource.data.etablissementId) && dansPerimetre(request.resource.data.etablissementId)
          && valideSalle(request.resource.data) && request.resource.data.patientId == resource.data.patientId
          && request.resource.data.jour == resource.data.jour
          && ((etapeLibre(resource.data) && etapeLibre(request.resource.data)) || commentaireSeul())
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['prix', 'prixPar', 'prixNom']) || prixPermis());
        allow delete: if dansPerimetre(resource.data.etablissementId) && etapeLibre(resource.data);
      }
      // Rappels WhatsApp envoyés (R-C4, 19/10/2026, audit 4 C7) : un document par patient, { patientId, etablissementId, l: { "AAAA-MM-JJ|catégorie":
      // { le, par, nom } }, majPar, maj }, à la place du champ `rappels` du dossier (qui réécrivait tout le dossier). Lu dans le périmètre ;
      // écrit avec le droit « rendezvous », signé par la personne connectée ; retiré avec le dossier.
      match /rappels/{p} {
        function valideRappel(d) { return d.patientId == p && d.etablissementId is string && d.l is map && d.majPar == request.auth.uid; }
        allow read: if resource == null ? estMembre() : dansPerimetre(resource.data.etablissementId);
        allow create: if droit('rendezvous') && dansPerimetre(request.resource.data.etablissementId) && valideRappel(request.resource.data);
        allow update: if droit('rendezvous') && dansPerimetre(resource.data.etablissementId) && dansPerimetre(request.resource.data.etablissementId)
          && valideRappel(request.resource.data);
        allow delete: if droit('rendezvous') && dansPerimetre(resource.data.etablissementId);
      }
      // N° d'ordre de passage (SA4, 10/10/2026) : un compteur par jour et par établissement, qui ne fait que monter
      match /salleOrdre/{c} {
        function compteurValide(d) { return d.n is int && d.majPar == request.auth.uid && d.jour is string && c == d.jour + '_' + d.etablissementId; }
        allow read: if resource == null ? estMembre() : dansPerimetre(resource.data.etablissementId);
        allow create: if dansPerimetre(request.resource.data.etablissementId) && compteurValide(request.resource.data) && request.resource.data.n >= 1;
        allow update: if dansPerimetre(resource.data.etablissementId) && compteurValide(request.resource.data)
          && request.resource.data.etablissementId == resource.data.etablissementId && request.resource.data.n > resource.data.n;
        allow delete: if false;
      }
      // « Dossier ouvert par » (salle d'attente, 08/10/2026) : chacun écrit seulement son propre document (patient ouvert, nom,
      // heure), lu par les membres du cabinet
      // Carte des médecins (3.9, 12/10/2026) : nom, titre, spécialité, INPE, signature scannée, publiés par chaque médecin lui-même
      // pour l'en-tête et la signature des ordonnances (choix du médecin signataire) ; lue par l'équipe (pas le comptable)
      match /signataires/{uid} {
        allow read: if estMembre() && !comptable();
        allow write: if estMembre() && uid == request.auth.uid && m().role == 'medecin';
      }
      match /presence/{uid} {
        allow read: if estMembre() && !comptable();
        allow write: if estMembre() && uid == request.auth.uid;
      }
      // Montants des dossiers, tarifs, paiements, versements : uniquement avec le droit « finances »
      // R-D3 (20/10/2026, audit n° 6, C8) : lus dans la limite des établissements du membre, comme les prix à encaisser (le comptable
      // n'en lit aucun : il lit le relevé) ; liste complète pour un membre de tous les établissements, sinon demandée par établissement
      match /patientsFinances/{p} {
        allow read: if droit('finances') && (resource == null || dansPerimetre(resource.data.etablissementId));
        allow write: if droit('finances') && !comptable();
      }
      // Relevé financier du comptable (date, acte facturé, montant ; nom et n° de dossier, sans diagnostic) : préparé par un médecin
      // qui a le droit « finances » (bilan.js publierReleve), lu avec ce droit (comptable compris)
      match /comptabilite/{d} { allow read: if droit('finances'); allow write: if droit('finances') && !comptable(); }
      // Prix à encaisser (consultations validées, consultation de chimio) : extrait des montants, lisible avec le droit « encaissements »
      match /encaissements/{p} {
        allow read: if (droit('finances') || droit('encaissements')) && (resource == null || dansPerimetre(resource.data.etablissementId));
        allow write: if droit('finances') && !comptable();
      }
      // Reçus numérotés (SA9c, 11/10/2026) : recus/{patient}_{clé} = numéro R-AAAA-NNNN tiré du compteur de l'année
      // (recusCompteur/{AAAA}, +1 à chaque nouveau numéro, dans la même transaction) ; réimpression = duplicata (seuls imp / dernier…
      // changent) ; montant ou mode changé = nouveau numéro, l'ancien passe dans « annules ». Jamais supprimés.
      function recuDroit() { return (droit('finances') || droit('encaissements')) && !comptable(); }
      function cheminCompteurRecus(a) { return /databases/$(database)/documents/espaces/$(e)/recusCompteur/$(a); }
      match /recus/{r} {
        function numeroTire(d) {
          return d.n is int && d.annee is string && d.numero is string && existsAfter(cheminCompteurRecus(d.annee))
            && getAfter(cheminCompteurRecus(d.annee)).data.n == d.n
            && d.n == (exists(cheminCompteurRecus(d.annee)) ? get(cheminCompteurRecus(d.annee)).data.n : 0) + 1;
        }
        // R-D3 (20/10/2026, audit n° 6, C8) : nouveau numéro = anciens numéros annulés gardés tels quels, plus le numéro remplacé (son numéro et
        // son montant), signé par la personne connectée
        function annuleVerifie(l, a) {
          return l.size() == a.annules.size() + 1 && l.hasAll(a.annules)
            && l[a.annules.size()].numero == a.numero && l[a.annules.size()].m == a.m && l[a.annules.size()].par == request.auth.uid;
        }
        function recuValide(d) { return d.patientId is string && d.cle is string && r == d.patientId + '_' + d.cle && d.m is number && d.par == request.auth.uid && d.annules is list; }
        allow read: if recuDroit() && (resource == null || dansPerimetre(resource.data.etablissementId));
        allow create: if recuDroit() && dansPerimetre(request.resource.data.etablissementId) && recuValide(request.resource.data) && numeroTire(request.resource.data)
          && request.resource.data.annules.size() == 0;
        allow update: if recuDroit() && dansPerimetre(resource.data.etablissementId) && dansPerimetre(request.resource.data.etablissementId)
          && request.resource.data.patientId == resource.data.patientId && request.resource.data.cle == resource.data.cle
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imp', 'dernier', 'dernierPar', 'dernierNom']) && request.resource.data.dernierPar == request.auth.uid)
            // R-B5 (19/10/2026) : historique du prix changé après la remise du reçu : une entrée de plus, signée par la personne connectée
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prix']) && request.resource.data.prix is list
              && request.resource.data.prix.size() == resource.data.get('prix', []).size() + 1 && request.resource.data.prix[request.resource.data.prix.size() - 1].par == request.auth.uid)
            || (recuValide(request.resource.data) && numeroTire(request.resource.data) && annuleVerifie(request.resource.data.annules, resource.data)));
        allow delete: if false;
      }
      match /recusCompteur/{a} {
        allow read: if recuDroit();
        allow create: if recuDroit() && a.matches('^[0-9]{4}$') && request.resource.data.n == 1 && request.resource.data.majPar == request.auth.uid;
        allow update: if recuDroit() && request.resource.data.n == resource.data.n + 1 && request.resource.data.majPar == request.auth.uid;
        allow delete: if false;
      }
      // Comptable : pointe les paiements et saisit les versements, sans toucher aux tarifs
      // R-D4 (20/10/2026) : cases « Payé » rangées par année (paiements_AAAA), pointées aussi par le comptable
      match /finances/{d} { allow read: if droit('finances'); allow write: if droit('finances') && (!comptable() || d in ['paiements', 'versements'] || d.matches('paiements_[0-9]{4}')); }
      // Bibliothèque et paramètres : lecture par les membres, modification avec le droit « paramètres »
      // 2.4 (12/10/2026, audit) : modifiés par un médecin seulement (avec le droit « paramètres »)
      match /protocoles/{d} { allow read: if estMembre(); allow write: if droit('parametres') && estMed(); }
      // Référentiel de radiothérapie (RTR, RT1 du 25/10/2026) : changements du cabinet par schéma (la référence est dans le site,
      // public/donnees-rt). Module « rt » et fonction « rt.referentiel » du réglage ; droit referentielRT (aucun | voir | modifier) :
      // médecin sans droit noté = « modifier » ; le comptable ne le lit jamais ; seul un médecin avec « modifier » écrit, signé par lui-même
      function rtRefFn() { return get(/databases/$(database)/documents/espaces/$(e)).data.get('abonnement', {}).get('reglage', {}).get('fonctions', {}).get('rt.referentiel', true) != false; }
      function rtRefVoir() { return estMembre() && moduleOn('rt') && rtRefFn() && m().role != 'comptable' && (m().droits.get('referentielRT', 'aucun') in ['voir', 'modifier'] || (estMed() && !('referentielRT' in m().droits))); }
      function rtRefModif() { return estMembre() && moduleOn('rt') && rtRefFn() && estMed() && m().droits.get('referentielRT', 'modifier') == 'modifier'; }
      match /referentielRT/{s} {
        allow read: if rtRefVoir();
        allow create, update: if rtRefModif() && request.resource.data.majPar == request.auth.uid;
        allow delete: if rtRefModif();
      }
      // Paramètres du secrétariat (droit « secretariat », secrétaire, 10/10/2026) : absences, jours fériés et horaires (calendrier),
      // listes, types de tâches et de documents, messages WhatsApp, dates de RCP, réglages (bouton vert, impression, alertes, salle
      // d'attente) ; restent au droit « paramètres » : couleurs Google Agenda, tâches automatiques, tarifs, etc.
      match /parametres/{d} {
        allow read: if estMembre();
        allow write: if droit('parametres') || (droit('secretariat') && d in ['calendrier', 'listes', 'typesTaches', 'typesDocuments', 'reglages', 'whatsapp', 'rcp']);
      }
      // Listes (diagnostics, mutuelles, correspondants) : un nom nouveau tapé dans une fiche patient s'y ajoute, pour tout
      // membre qui crée ou modifie une fiche (08/10/2026) ; corrections et suppressions dans Paramètres (droit « paramètres »)
      match /parametres/listes { allow write: if droit('identite') || droit('fichePatient') || droit('creerPatient'); }
      // « Administrée par… le… à… » : ajout seulement, jamais modifié ni effacé
      match /administrations/{a} {
        allow read: if dansPerimetre(resource.data.etablissementId);
        allow create: if droit('administrer') && dansPerimetre(request.resource.data.etablissementId)
          && request.resource.data.parUid == request.auth.uid && request.resource.data.le == request.time;
        allow update, delete: if false;
      }
      // Historique : ajout seulement ; lecture complète avec le droit « finances » (médecin), sinon ses propres actions
      match /historique/{h} {
        allow read: if (droit('finances') && !comptable()) || (estMembre() && resource.data.parUid == request.auth.uid);
        allow create: if estMembre() && request.resource.data.parUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
