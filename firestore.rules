rules_version = '2';
// Chimio HGC – règles de sécurité
//  • Partie 1 : application actuelle (v1) – INCHANGÉE.
//  • Partie 2 : plateforme v2 multi-utilisateurs (espaces/…) – droits par membre, choisis par le médecin.
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() { return request.auth != null; }
    function proprietaire() { return connecte() && request.auth.token.email == 'ritabentahila@gmail.com'; }

    // ───────────── PARTIE 1 : ancienne application (v1) – LECTURE SEULE depuis la bascule du 06/10/2026 ─────────────
    // Les données sont consultables (ancienne-app.html, conversion) mais plus rien ne s'y écrit : Onco360 est la référence.
    function cheminRole() { return /databases/$(database)/documents/roles/$(request.auth.uid); }
    function role() { return exists(cheminRole()) ? get(cheminRole()).data.role : ''; }
    function estAdminV1() { return proprietaire() || (connecte() && role() == 'admin'); }
    function estEquipe() { return estAdminV1() || (connecte() && role() in ['medecin', 'secretaire']); }
    match /patients/{id} { allow read: if estEquipe(); allow write: if false; }
    match /protocoles/{id} { allow read: if estEquipe(); allow write: if false; }
    match /parametres/{id} { allow read: if estEquipe(); allow write: if false; }
    match /finances/{document=**} { allow read: if estAdminV1(); allow write: if false; }
    match /roles/{uid} { allow read: if connecte() && (request.auth.uid == uid || estAdminV1()); allow write: if estAdminV1(); }
    match /historique/{id} { allow read: if estAdminV1(); allow create, update, delete: if false; }

    // ───────────── PARTIE 2 : v2 ─────────────
    // Administrateurs de la plateforme
    function estAdmin() { return proprietaire() || (connecte() && exists(/databases/$(database)/documents/administrateurs/$(request.auth.uid))); }
    match /administrateurs/{uid} { allow read: if connecte() && (request.auth.uid == uid || estAdmin()); allow write: if estAdmin(); }

    // Profil personnel : chacun lit et modifie le sien (aucun droit n'y est stocké)
    match /utilisateurs/{uid} {
      allow read: if connecte() && (request.auth.uid == uid || estAdmin());
      allow create, update: if connecte() && (request.auth.uid == uid || estAdmin());
      allow delete: if estAdmin();
    }

    match /espaces/{e} {
      function cheminMembre() { return /databases/$(database)/documents/espaces/$(e)/membres/$(request.auth.uid); }
      function m() { return get(cheminMembre()).data; }
      function estMembre() { return connecte() && exists(cheminMembre()) && m().actif == true; }
      function estTitulaire() { return connecte() && get(/databases/$(database)/documents/espaces/$(e)).data.titulaire == request.auth.uid; }
      function droit(k) { return estMembre() && m().droits[k] == true; }
      function traitementsModif() { return estMembre() && m().droits.traitements == 'modifier'; }
      function rtModif() { return estMembre() && m().droits.radiotherapie == 'modifier'; }
      function tousEtab() { return estMembre() && m().tousEtablissements == true; }
      function dansPerimetre(etab) { return estMembre() && (m().tousEtablissements == true || etab in m().etablissements); }
      // Champs d'un dossier patient que ce membre a le droit de modifier
      function champsAutorises() {
        return ['resume', 'version', 'maj', 'majPar']
          .concat(droit('identite') ? ['identite'] : [])
          .concat(droit('fichePatient') ? ['clinique'] : [])
          .concat(droit('rendezvous') ? ['rdvsJson'] : [])
          .concat(droit('planningChimio') || traitementsModif() ? ['planningJson'] : [])
          .concat(traitementsModif() ? ['lignesJson', 'clinique'] : [])
          .concat(rtModif() ? ['rtsJson'] : [])
          .concat(tousEtab() ? ['etablissementId'] : []);
      }
      // Fiche du patient (droit « fichePatient », secrétaire) : poids, taille, allergies… mais pas le résumé médical (clinique.notes)
      function notesInchangees() {
        return traitementsModif() || request.resource.data.get('clinique', {}).get('notes', '') == resource.data.get('clinique', {}).get('notes', '');
      }
      function notesVides() { return traitementsModif() || request.resource.data.get('clinique', {}).get('notes', '') == ''; }
      // Toute écriture d'un dossier : version suivante, auteur et heure fixés par le serveur
      function versionSuivante() {
        return request.resource.data.version == resource.data.version + 1
          && request.resource.data.majPar == request.auth.uid
          && request.resource.data.maj == request.time;
      }

      allow read: if estMembre() || estAdmin();
      allow write: if estAdmin();

      // Membres et leurs droits : gérés par le médecin titulaire (ou l'administrateur). Un membre ne modifie jamais ses propres droits.
      match /membres/{uid} {
        allow read: if estMembre() || estAdmin();
        allow write: if estAdmin() || (estTitulaire() && uid != request.auth.uid);
      }
      // Établissements (nom, adresse, logo) : visibles par les membres, modifiables avec le droit « paramètres »
      match /etablissements/{x} {
        allow read: if estMembre() || estAdmin();
        allow write: if droit('parametres') || estAdmin();
      }
      // Dossiers patients (sans aucun montant)
      match /patients/{p} {
        allow read: if dansPerimetre(resource.data.etablissementId);
        allow create: if droit('creerPatient') && dansPerimetre(request.resource.data.etablissementId)
          && request.resource.data.version == 1 && request.resource.data.majPar == request.auth.uid && request.resource.data.maj == request.time
          && request.resource.data.keys().hasOnly(champsAutorises().concat(['etablissementId'])) && notesVides();
        allow update: if dansPerimetre(resource.data.etablissementId) && versionSuivante()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(champsAutorises()) && notesInchangees();
        allow delete: if droit('supprimerPatient') && dansPerimetre(resource.data.etablissementId);
      }
      // Journal des consultations (une fiche par consultation, avec le patient et son établissement) : lu par tous les membres
      // (périmètre), écrit avec le droit « ecrireConsultations » (médecin, secrétaire), supprimé par le médecin (toutes) ou
      // par celui qui l'a créée (07/10/2026)
      match /consultations/{c} {
        allow read: if dansPerimetre(resource.data.etablissementId);
        allow create: if droit('ecrireConsultations') && dansPerimetre(request.resource.data.etablissementId)
          && request.resource.data.creePar == request.auth.uid && request.resource.data.majPar == request.auth.uid;
        allow update: if droit('ecrireConsultations') && dansPerimetre(resource.data.etablissementId)
          && dansPerimetre(request.resource.data.etablissementId) && request.resource.data.majPar == request.auth.uid
          && request.resource.data.creePar == resource.data.creePar && request.resource.data.patientId == resource.data.patientId;
        // suppression : le médecin ; la secrétaire celles qu'elle a créées, et une consultation « Ordonnance » vidée
        allow delete: if droit('ecrireConsultations') && dansPerimetre(resource.data.etablissementId)
          && (m().role == 'medecin' || resource.data.creePar == request.auth.uid || (resource.data.titre == 'Ordonnance' && resource.data.get('type', '') == ''
              && resource.data.get('note', '') == '' && resource.data.get('lignes', []).size() == 0));
      }
      // Bibliothèques des prescriptions (médicaments, examens, ordonnances types, analyses, courriers) : lues par les
      // membres, modifiées par le médecin seulement (07/10/2026 : la secrétaire s'en sert sans les changer)
      match /bibliotheques/{b} { allow read: if estMembre(); allow write: if droit('ecrireConsultations') && m().role == 'medecin'; }
      // Documents de radiothérapie (pli confidentiel, compte rendu de fin, rendez-vous) enregistrés depuis leur fenêtre :
      // lus, modifiés et supprimés avec le droit « documents » (médecin, secrétaire), dans le périmètre du membre
      match /documentsRT/{d} {
        allow read, delete: if droit('documents') && dansPerimetre(resource.data.etablissementId);
        allow create: if droit('documents') && dansPerimetre(request.resource.data.etablissementId) && request.resource.data.majPar == request.auth.uid;
        allow update: if droit('documents') && dansPerimetre(resource.data.etablissementId) && dansPerimetre(request.resource.data.etablissementId)
          && request.resource.data.majPar == request.auth.uid;
      }
      // Documents déposés dans le dossier (onglet Documents, 08/10/2026) : fiche du fichier (titre, date, type, chemin dans le
      // stockage, voir storage.rules) ; droit « documents » dans le périmètre ; supprimés par le médecin ou par qui les a déposés
      match /fichiers/{f} {
        allow read: if droit('documents') && dansPerimetre(resource.data.etablissementId);
        allow create: if droit('documents') && dansPerimetre(request.resource.data.etablissementId)
          && request.resource.data.creePar == request.auth.uid && request.resource.data.majPar == request.auth.uid;
        allow update: if droit('documents') && dansPerimetre(resource.data.etablissementId) && dansPerimetre(request.resource.data.etablissementId)
          && request.resource.data.majPar == request.auth.uid && request.resource.data.creePar == resource.data.creePar
          && request.resource.data.patientId == resource.data.patientId && request.resource.data.chemin == resource.data.chemin;
        allow delete: if droit('documents') && dansPerimetre(resource.data.etablissementId)
          && (m().role == 'medecin' || resource.data.creePar == request.auth.uid);
      }
      // Tâches de l'équipe (07/10/2026) : les médecins les voient toutes ; les autres celles qu'ils ont créées ou dont ils sont
      // responsables (qui = [auteur, responsable]). Modification et réattribution : l'auteur, le responsable, les médecins ;
      // l'auteur ne change jamais ; chaque modification ou commentaire ajoute une entrée au fil (historique), qui ne rétrécit
      // jamais, signée par la personne connectée (08/10/2026).
      // Suppression : l'auteur, toujours (même terminée, 08/10/2026) ; un médecin, une tâche non terminée d'un autre.
      match /taches/{t} {
        function estMedecin() { return estMembre() && m().role == 'medecin'; }
        function concerne() { return estMedecin() || (estMembre() && request.auth.uid in resource.data.qui); }
        function valide(d) {
          return d.titre is string && d.titre.size() > 0 && d.statut in ['afaire', 'encours', 'fait'] && d.majPar == request.auth.uid
            && d.qui is list && d.qui.hasAll([d.de, d.pour]) && d.qui.hasOnly([d.de, d.pour])
            && exists(/databases/$(database)/documents/espaces/$(e)/membres/$(d.pour));
        }
        allow read: if concerne();
        allow create: if estMembre() && request.resource.data.de == request.auth.uid && valide(request.resource.data)
          && request.resource.data.statut == 'afaire' && request.resource.data.fil.size() == 1 && request.resource.data.fil[0].par == request.auth.uid;
        allow update: if concerne() && valide(request.resource.data) && request.resource.data.de == resource.data.de
          && request.resource.data.fil.size() == resource.data.fil.size() + 1
          && request.resource.data.fil[request.resource.data.fil.size() - 1].par == request.auth.uid;
        allow delete: if (estMembre() && resource.data.de == request.auth.uid) || (estMedecin() && resource.data.statut != 'fait');
      }
      // Salle d'attente (08/10/2026) : un document par patient, ligne du jour (rendez-vous ou séance de chimio) et jour, lu et
      // écrit dans le périmètre du membre. Tout membre « Met en salle » (état "" ou salle, infirmière comprise) ; démarrer la
      // consultation, valider, absent, retour en salle : droit « rendezvous » (médecin, secrétaire). Patient et jour ne changent pas.
      match /salle/{s} {
        function etapeLibre(d) { return d.etat in ['', 'salle'] || droit('rendezvous'); }
        function valideSalle(d) {
          return d.patientId is string && d.jour is string && d.cle is string && d.etat in ['', 'salle', 'consult', 'vu', 'absent']
            && d.majPar == request.auth.uid && s == d.jour + '_' + d.patientId + '_' + d.cle;
        }
        allow read: if dansPerimetre(resource.data.etablissementId);
        // prix payé d'avance (prix) : seulement avec le droit « encaissements » ou « finances » (08/10/2026)
        function prixPermis() { return droit('encaissements') || droit('finances'); }
        allow create: if dansPerimetre(request.resource.data.etablissementId) && valideSalle(request.resource.data) && etapeLibre(request.resource.data)
          && (!request.resource.data.keys().hasAny(['prix']) || prixPermis());
        // commentaire du jour (com) : tout membre du périmètre, quelle que soit l'étape (infirmière comprise, 08/10/2026)
        function commentaireSeul() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['com', 'comPar', 'comNom', 'maj', 'majPar']); }
        allow update: if dansPerimetre(resource.data.etablissementId) && dansPerimetre(request.resource.data.etablissementId)
          && valideSalle(request.resource.data) && request.resource.data.patientId == resource.data.patientId
          && request.resource.data.jour == resource.data.jour
          && ((etapeLibre(resource.data) && etapeLibre(request.resource.data)) || commentaireSeul())
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['prix', 'prixPar', 'prixNom']) || prixPermis());
        allow delete: if dansPerimetre(resource.data.etablissementId) && etapeLibre(resource.data);
      }
      // « Dossier ouvert par » (salle d'attente, 08/10/2026) : chacun écrit seulement son propre document (patient ouvert, nom,
      // heure), lu par les membres du cabinet
      match /presence/{uid} {
        allow read: if estMembre();
        allow write: if estMembre() && uid == request.auth.uid;
      }
      // Montants des dossiers, tarifs, paiements, versements : uniquement avec le droit « finances »
      match /patientsFinances/{p} { allow read, write: if droit('finances'); }
      // Prix à encaisser (consultations validées, consultation de chimio) : extrait des montants, lisible avec le droit « encaissements »
      match /encaissements/{p} {
        allow read: if (droit('finances') || droit('encaissements')) && (resource == null || dansPerimetre(resource.data.etablissementId));
        allow write: if droit('finances');
      }
      match /finances/{d} { allow read, write: if droit('finances'); }
      // Bibliothèque et paramètres : lecture par les membres, modification avec le droit « paramètres »
      match /protocoles/{d} { allow read: if estMembre(); allow write: if droit('parametres'); }
      match /parametres/{d} { allow read: if estMembre(); allow write: if droit('parametres'); }
      // Listes (diagnostics, mutuelles, correspondants) : un nom nouveau tapé dans une fiche patient s'y ajoute, pour tout
      // membre qui crée ou modifie une fiche (08/10/2026) ; corrections et suppressions dans Paramètres (droit « paramètres »)
      match /parametres/listes { allow write: if droit('identite') || droit('fichePatient') || droit('creerPatient'); }
      // « Administrée par… le… à… » : ajout seulement, jamais modifié ni effacé
      match /administrations/{a} {
        allow read: if dansPerimetre(resource.data.etablissementId);
        allow create: if droit('administrer') && dansPerimetre(request.resource.data.etablissementId)
          && request.resource.data.parUid == request.auth.uid && request.resource.data.le == request.time;
        allow update, delete: if false;
      }
      // Historique : ajout seulement ; lecture complète avec le droit « finances » (médecin), sinon ses propres actions
      match /historique/{h} {
        allow read: if droit('finances') || (estMembre() && resource.data.parUid == request.auth.uid);
        allow create: if estMembre() && request.resource.data.parUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
